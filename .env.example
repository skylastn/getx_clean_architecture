# Copy to .env and fill in real values, then pass each key to Flutter via --dart-define.
#   flutter run --flavor development --dart-define-from-file=<(...)   # or inline flags
# .env is gitignored; never commit real credentials.
#
#   flutter run --dart-define=APP_ENV=production \
#               --dart-define=BE_URL=https://be.example.com \
#               --dart-define=BASE_URL=https://example.com
#
# Keys below are all read by lib/core/env.dart via String.fromEnvironment,
# with the development value as the compiled-in default.

# development | production  (default: development)
APP_ENV=development

# Shown as the app/route title
APP_NAME=SkyKomik Dev

# Empty in this sample
APP_USERNAME=

# API root the data sources build endpoints from
BE_URL=https://be.demo.my.id

# Web/base host
BASE_URL=https://demo.id

# Prefix for asset/image URLs
IMAGE_URL=https://demo.id/file/

# Realtime endpoint (socket.io rejects this, so a raw websocket is used)
WEBSOCKET_URL=wss://demo.id/websocket

# Local database name
DB_NAME=DemoAppsDev